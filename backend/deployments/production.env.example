# Copy this file to .env on the server. Never commit the filled-in file.
# Recommended location: /data/website/24-calculate/server/deployments/.env

COMPOSE_PROJECT_NAME=twenty_four_calculate
APP_IMAGE_TAG=latest

# Existing Docker network that already contains Nginx / shared Redis / shared MySQL.
# On the current server this is expected to be docker-container_backend, but confirm
# with `docker network ls` before the first startup.
SHARED_DOCKER_NETWORK=docker-container_backend

# Keep the host binding local. The Dockerized Nginx can also proxy by container name:
# http://twenty_four_calculate_api:8080
API_BIND_HOST=127.0.0.1
API_PORT=18082

# MySQL is external/shared. Fill these after the production database is created.
GO_SERVICE_DATABASE_HOST=replace-with-mysql-host-or-container-name
GO_SERVICE_DATABASE_PORT=3306
GO_SERVICE_DATABASE_USER=replace-with-mysql-user
GO_SERVICE_DATABASE_PASSWORD=replace-with-mysql-password
GO_SERVICE_DATABASE_NAME=twenty_four

# Redis is external/shared. Prefer an unused logical DB for this project because
# Asynq also stores queue metadata in Redis.
GO_SERVICE_REDIS_ADDR=docker-container-redis-1:6379
GO_SERVICE_REDIS_PASSWORD=
GO_SERVICE_REDIS_DB=2

GO_SERVICE_WECHAT_APP_ID=wx1e7ac815548c561c
GO_SERVICE_WECHAT_APP_SECRET=replace-with-wechat-app-secret
GO_SERVICE_JWT_SECRET=replace-with-at-least-32-random-bytes
GO_SERVICE_GAME_DAILY_SEED_SECRET=replace-with-a-separate-daily-seed-secret
GO_SERVICE_WECHAT_API_BASE_URL=https://api.weixin.qq.com
GO_SERVICE_QUEUE_NAME=twenty_four_calculate
GO_SERVICE_LOG_LEVEL=info