# Native production environment file for /etc/24-calculate/api.env.
# Never commit the filled-in copy. Set permissions to 600 on the server.

GO_SERVICE_APP_NAME=twenty-four-calculate
GO_SERVICE_APP_ENV=production
GO_SERVICE_SERVER_HOST=127.0.0.1
GO_SERVICE_SERVER_PORT=8080

GO_SERVICE_DATABASE_HOST=127.0.0.1
GO_SERVICE_DATABASE_PORT=3306
GO_SERVICE_DATABASE_USER=replace-with-production-db-user
GO_SERVICE_DATABASE_PASSWORD=replace-with-production-db-password
GO_SERVICE_DATABASE_NAME=replace-with-production-db-name

# Redis/Memurai is a local host service. Use an isolated logical DB because
# Asynq also stores queue metadata in Redis.
GO_SERVICE_REDIS_ADDR=127.0.0.1:6379
GO_SERVICE_REDIS_PASSWORD=
GO_SERVICE_REDIS_DB=2

GO_SERVICE_WECHAT_APP_ID=wx1e7ac815548c561c
GO_SERVICE_WECHAT_APP_SECRET=replace-with-wechat-app-secret
GO_SERVICE_WECHAT_API_BASE_URL=https://api.weixin.qq.com

GO_SERVICE_JWT_SECRET=replace-with-at-least-32-random-bytes
GO_SERVICE_GAME_DAILY_SEED_SECRET=replace-with-a-separate-daily-seed-secret
GO_SERVICE_QUEUE_NAME=twenty_four_calculate
GO_SERVICE_LOG_LEVEL=info
GO_SERVICE_LOG_FORMAT=json

# Local avatar files. If Nginx serves /avatars/ on the same domain, this URL
# can remain the API domain; otherwise use the real HTTPS CDN/object-storage
# domain and keep the Nginx location in sync with the storage directory.
GO_SERVICE_AVATAR_STORAGE_DIR=/var/lib/24-calculate/avatars
GO_SERVICE_AVATAR_PUBLIC_BASE_URL=https://calc-api.pdurl.cn
GO_SERVICE_AVATAR_MAX_BYTES=2097152
GO_SERVICE_AVATAR_MAX_DIMENSION=4096
GO_SERVICE_AVATAR_UPLOAD_COOLDOWN_SECONDS=30
