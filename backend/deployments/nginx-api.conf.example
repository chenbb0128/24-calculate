# Nginx reverse-proxy fragment for the existing Dockerized Nginx server.
# Replace the server_name and certificate paths with the actual certificate setup.
# If Nginx is on the same Docker network as the API container, proxy by container
# name. If Nginx runs on the host, use http://127.0.0.1:18082 instead.

server {
    listen 443 ssl http2;
    server_name game-api.banxiaoguan.cn;

    ssl_certificate     /etc/nginx/certs/game-api.banxiaoguan.cn/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/game-api.banxiaoguan.cn/privkey.pem;

    client_max_body_size 2m;

    location / {
        proxy_pass http://twenty_four_calculate_api:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
}