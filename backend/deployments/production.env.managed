# 24-calculate Backend managed production environment.
# This template is safe to commit: protected values are preserved from the
# server-side root-owned backend/deployments/.env during deployment.
ZDZQ_CONFIG_SHA=ec7a807961f6601ddab05001f8a76f8016ada6517e5beccb72f25072b19613e3
COMPOSE_PROJECT_NAME=twenty_four_calculate
SHARED_DOCKER_NETWORK=docker-container_backend
API_BIND_HOST=127.0.0.1
API_PORT=18082
AVATAR_STORAGE_PATH=/data/website/24-calculate/avatars

GO_SERVICE_APP_NAME=twenty-four-calculate
GO_SERVICE_APP_ENV=production
GO_SERVICE_SERVER_HOST=0.0.0.0
GO_SERVICE_SERVER_PORT=8080
GO_SERVICE_ADMIN_STATIC_DIR=/app/admin
GO_SERVICE_ADMIN_USERNAME=${PROD_SECRET:GO_SERVICE_ADMIN_USERNAME}
GO_SERVICE_ADMIN_PASSWORD=${PROD_SECRET:GO_SERVICE_ADMIN_PASSWORD}
GO_SERVICE_ADMIN_PASSWORD_RESET=true

GO_SERVICE_DATABASE_HOST=172.17.0.1
GO_SERVICE_DATABASE_PORT=3306
GO_SERVICE_DATABASE_USER=${PROD_SECRET:GO_SERVICE_DATABASE_USER}
GO_SERVICE_DATABASE_PASSWORD=${PROD_SECRET:GO_SERVICE_DATABASE_PASSWORD}
GO_SERVICE_DATABASE_NAME=twenty_four

GO_SERVICE_REDIS_ADDR=docker-container-redis-1:6379
GO_SERVICE_REDIS_PASSWORD=${PROD_SECRET:GO_SERVICE_REDIS_PASSWORD}
GO_SERVICE_REDIS_DB=3

GO_SERVICE_WECHAT_APP_ID=wx1e7ac815548c561c
GO_SERVICE_WECHAT_APP_SECRET=${PROD_SECRET:GO_SERVICE_WECHAT_APP_SECRET}
GO_SERVICE_WECHAT_API_BASE_URL=https://api.weixin.qq.com
GO_SERVICE_MODERATION_TIMEOUT=5s
GO_SERVICE_MODERATION_MAX_RETRIES=1
GO_SERVICE_TAPTAP_APP_ID=
GO_SERVICE_TAPTAP_APP_SECRET=
GO_SERVICE_TAPTAP_API_BASE_URL=https://cloud-miniapp.tapapis.cn

GO_SERVICE_JWT_SECRET=${PROD_SECRET:GO_SERVICE_JWT_SECRET}
GO_SERVICE_GAME_DAILY_SEED_SECRET=${PROD_SECRET:GO_SERVICE_GAME_DAILY_SEED_SECRET}
GO_SERVICE_GAME_CAMPAIGN_CONTENT_VERSION=v1
GO_SERVICE_GAME_CAMPAIGN_CONTENT_SECRET=${PROD_SECRET:GO_SERVICE_GAME_CAMPAIGN_CONTENT_SECRET}
GO_SERVICE_QUEUE_NAME=twenty_four_calculate
GO_SERVICE_LOG_LEVEL=info
GO_SERVICE_LOG_FORMAT=json

GO_SERVICE_AVATAR_PUBLIC_BASE_URL=https://calc-api.pdurl.cn
GO_SERVICE_AVATAR_MAX_BYTES=2097152
GO_SERVICE_AVATAR_MAX_DIMENSION=4096
GO_SERVICE_AVATAR_UPLOAD_COOLDOWN_SECONDS=30
