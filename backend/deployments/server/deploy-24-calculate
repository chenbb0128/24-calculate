#!/usr/bin/env bash

set -Eeuo pipefail

EXPECTED_SHA="${1:-}"
if [[ $# -gt 0 ]]; then shift; fi
IMAGE_INPUT_MODE="${IMAGE_INPUT_MODE:-registry}"
CONFIG_SHA=""
ENV_PROD_B64=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        --image-input=*) IMAGE_INPUT_MODE="${1#--image-input=}" ;;
        --config-sha=*) CONFIG_SHA="${1#--config-sha=}" ;;
        --env-prod-b64=*) ENV_PROD_B64="${1#--env-prod-b64=}" ;;
        *) printf 'Unsupported argument: %s\n' "$1" >&2; exit 64 ;;
    esac
    shift
done

readonly EXPECTED_SHA
readonly IMAGE_INPUT_MODE
readonly CONFIG_SHA
readonly ENV_PROD_B64

readonly APP_DIR="/data/website/24-calculate/server"
readonly DEPLOY_DIR="$APP_DIR/backend/deployments"
readonly COMPOSE_FILE="/etc/24-calculate/docker-compose.production.yml"
readonly ENV_FILE="$DEPLOY_DIR/.env"
readonly IMAGE_NAME="registry.cn-hangzhou.aliyuncs.com/zdzq/24-calculate-backend"
readonly ACR_REGISTRY="${ACR_REGISTRY:-registry.cn-hangzhou.aliyuncs.com}"
readonly ACR_IMAGE_NAME="${ACR_IMAGE_NAME:-registry.cn-hangzhou.aliyuncs.com/zdzq/24-calculate-backend}"
readonly API_CONTAINER="twenty_four_calculate_api"
readonly WORKER_CONTAINER="twenty_four_calculate_worker"
readonly HEALTH_URL="https://calc-api.pdurl.cn/ready"
readonly LOCAL_HEALTH_URL="http://127.0.0.1:18082/ready"
readonly AVATAR_DIR="/data/website/24-calculate/avatars"
readonly BACKUP_DIR="/data/backups/24-calculate/mysql"
readonly LOCK_FILE="/var/lock/24-calculate-deploy.lock"
readonly IMAGE_ARCHIVE_MAX_MB="${IMAGE_ARCHIVE_MAX_MB:-2048}"
readonly IMAGE_UPLOAD_TIMEOUT_SECONDS="${IMAGE_UPLOAD_TIMEOUT_SECONDS:-900}"
readonly IMAGE_LOAD_TIMEOUT_SECONDS="${IMAGE_LOAD_TIMEOUT_SECONDS:-900}"
readonly ENV_HELPER="/usr/local/libexec/24-calculate-managed-env.sh"
readonly ENV_BACKUP_DIR="/data/backups/24-calculate/env"
readonly -a ENV_SECRET_KEYS=(
    GO_SERVICE_DATABASE_USER
    GO_SERVICE_DATABASE_PASSWORD
    GO_SERVICE_REDIS_PASSWORD
    GO_SERVICE_WECHAT_APP_SECRET
    GO_SERVICE_JWT_SECRET
    GO_SERVICE_GAME_DAILY_SEED_SECRET
    GO_SERVICE_GAME_CAMPAIGN_CONTENT_SECRET
)
readonly -a ENV_NONEMPTY_SECRET_KEYS=(
    GO_SERVICE_DATABASE_USER
    GO_SERVICE_DATABASE_PASSWORD
    GO_SERVICE_WECHAT_APP_SECRET
    GO_SERVICE_JWT_SECRET
    GO_SERVICE_GAME_DAILY_SEED_SECRET
    GO_SERVICE_GAME_CAMPAIGN_CONTENT_SECRET
)
readonly -a ENV_REQUIRED_KEYS=(
    ZDZQ_CONFIG_SHA
    COMPOSE_PROJECT_NAME
    SHARED_DOCKER_NETWORK
    API_BIND_HOST
    API_PORT
    GO_SERVICE_DATABASE_HOST
    GO_SERVICE_DATABASE_PORT
    GO_SERVICE_DATABASE_USER
    GO_SERVICE_DATABASE_PASSWORD
    GO_SERVICE_DATABASE_NAME
    GO_SERVICE_REDIS_ADDR
    GO_SERVICE_REDIS_DB
    GO_SERVICE_JWT_SECRET
)

docker_config_dir=""
image_archive=""
backup_temporary_file=""
previous_image_id=""
services_switched=0
registry_user=""
registry_password=""

log() {
    printf '[%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*"
}

fail() {
    log "ERROR: $*" >&2
    exit 1
}

[[ -r "$ENV_HELPER" ]] || fail "Managed environment helper not found: $ENV_HELPER"
# shellcheck source=/dev/null
source "$ENV_HELPER"

compose() {
    APP_IMAGE_TAG="$EXPECTED_SHA" docker compose \
        -f "$COMPOSE_FILE" \
        --env-file "$ENV_FILE" \
        "$@"
}

read_env_value() {
    local key="$1"
    local line

    line="$(grep -m1 "^${key}=" "$ENV_FILE")" \
        || fail "Required environment value is missing: $key"
    printf '%s' "${line#*=}"
}

read_optional_env_value() {
    local key="$1"
    local line

    line="$(grep -m1 "^${key}=" "$ENV_FILE" || true)"
    [[ -n "$line" ]] || return 0
    printf '%s' "${line#*=}"
}

seed_admin_if_configured() {
    local admin_username
    local admin_password
    local seed_output

    admin_username="$(read_optional_env_value GO_SERVICE_ADMIN_USERNAME)"
    admin_password="$(read_optional_env_value GO_SERVICE_ADMIN_PASSWORD)"

    if [[ -z "$admin_username" && -z "$admin_password" ]]; then
        log 'Administrator seed skipped: no admin credentials configured'
        return 0
    fi

    [[ -n "$admin_username" && -n "$admin_password" ]] \
        || fail 'Both GO_SERVICE_ADMIN_USERNAME and GO_SERVICE_ADMIN_PASSWORD must be configured for admin seed'

    log 'Seeding administrator from the server-only environment'
    if seed_output="$(compose --profile seed run --rm --no-deps admin-seed 2>&1)"; then
        log 'Administrator seed completed'
        return 0
    fi

    if grep -Fq 'admin username already exists' <<<"$seed_output"; then
        log 'Administrator already exists; leaving its credentials unchanged'
        return 0
    fi

    printf '%s\n' "$seed_output" >&2
    return 1
}

backup_database() {
    local db_host
    local db_port
    local db_user
    local db_password
    local db_name
    local timestamp
    local backup_file

    db_host="$(read_env_value GO_SERVICE_DATABASE_HOST)"
    db_port="$(read_env_value GO_SERVICE_DATABASE_PORT)"
    db_user="$(read_env_value GO_SERVICE_DATABASE_USER)"
    db_password="$(read_env_value GO_SERVICE_DATABASE_PASSWORD)"
    db_name="$(read_env_value GO_SERVICE_DATABASE_NAME)"

    timestamp="$(date -u '+%Y%m%dT%H%M%SZ')"
    backup_file="$BACKUP_DIR/${timestamp}.sql.gz"
    backup_temporary_file="${backup_file}.tmp"

    install -d -m 0700 "$BACKUP_DIR"
    log "Backing up MySQL before migrations: $backup_file"

    MYSQL_PWD="$db_password" mysqldump \
        --host="$db_host" \
        --port="$db_port" \
        --user="$db_user" \
        --single-transaction \
        --quick \
        --skip-lock-tables \
        --default-character-set=utf8mb4 \
        "$db_name" | gzip -1 > "$backup_temporary_file"

    chmod 0600 "$backup_temporary_file"
    mv "$backup_temporary_file" "$backup_file"
    backup_temporary_file=""
    sha256sum "$backup_file" > "${backup_file}.sha256"
    chmod 0600 "${backup_file}.sha256"

    db_password=""
}

read_registry_credentials() {
    local label="$1"

    IFS= read -r registry_user || fail "Missing $label username on standard input"
    IFS= read -r registry_password || fail "Missing $label password on standard input"
    registry_user=${registry_user//$'\r'/}
    registry_user=${registry_user//$'\n'/}
    registry_password=${registry_password//$'\r'/}
    registry_password=${registry_password//$'\n'/}
    [[ -n "$registry_user" ]] || fail "$label username must not be empty"
    [[ -n "$registry_password" ]] || fail "$label password must not be empty"
}

pull_image_with_credentials() {
    local registry="$1"
    local source_image="$2"
    local target_image="$3"
    local label="$4"

    read_registry_credentials "$label"

    docker_config_dir="$(mktemp -d /tmp/24-calculate-docker-config.XXXXXX)"
    chmod 0700 "$docker_config_dir"

    log "Pulling immutable image $source_image"
    printf '%s' "$registry_password" | DOCKER_CONFIG="$docker_config_dir" \
        docker login "$registry" --username "$registry_user" --password-stdin >/dev/null
    DOCKER_CONFIG="$docker_config_dir" docker pull "$source_image"
    registry_password=""

    if [[ "$source_image" != "$target_image" ]]; then
        docker tag "$source_image" "$target_image"
    fi
    docker image inspect "$target_image" >/dev/null \
        || fail "Pulled image is missing expected tag: $target_image"

    rm -rf -- "$docker_config_dir"
    docker_config_dir=""
}

pull_registry_image() {
    pull_image_with_credentials \
        "$ACR_REGISTRY" \
        "$IMAGE_NAME:$EXPECTED_SHA" \
        "$IMAGE_NAME:$EXPECTED_SHA" \
        "ACR"
}

pull_acr_image() {
    pull_image_with_credentials \
        "$ACR_REGISTRY" \
        "$ACR_IMAGE_NAME:$EXPECTED_SHA" \
        "$IMAGE_NAME:$EXPECTED_SHA" \
        "ACR"
}

receive_streamed_image() {
    local max_blocks
    local max_bytes
    local archive_bytes

    command -v gzip >/dev/null || fail 'gzip is not installed'
    command -v timeout >/dev/null || fail 'timeout is not installed'

    max_blocks=$((IMAGE_ARCHIVE_MAX_MB + 1))
    max_bytes=$((IMAGE_ARCHIVE_MAX_MB * 1024 * 1024))
    image_archive="$(mktemp /tmp/24-calculate-image.XXXXXX.tar.gz)"
    chmod 0600 "$image_archive"

    log "Receiving streamed Docker image archive for $IMAGE_NAME:$EXPECTED_SHA"
    timeout "$IMAGE_UPLOAD_TIMEOUT_SECONDS" dd bs=1M count="$max_blocks" of="$image_archive"

    archive_bytes="$(wc -c < "$image_archive" | tr -d '[:space:]')"
    [[ "$archive_bytes" -gt 0 ]] || fail 'Streamed image archive is empty'
    [[ "$archive_bytes" -le "$max_bytes" ]] \
        || fail "Streamed image archive exceeds ${IMAGE_ARCHIVE_MAX_MB}MB limit"

    gzip -t "$image_archive" || fail 'Streamed image archive is not a valid gzip archive'

    log "Loading streamed Docker image $IMAGE_NAME:$EXPECTED_SHA"
    timeout "$IMAGE_LOAD_TIMEOUT_SECONDS" docker load -i "$image_archive" >/dev/null
    docker image inspect "$IMAGE_NAME:$EXPECTED_SHA" >/dev/null \
        || fail "Loaded image is missing expected tag: $IMAGE_NAME:$EXPECTED_SHA"

    rm -f -- "$image_archive"
    image_archive=""
}

prepare_image() {
    case "$IMAGE_INPUT_MODE" in
        registry)
            pull_registry_image
            ;;
        acr)
            pull_acr_image
            ;;
        tar)
            receive_streamed_image
            ;;
        *)
            fail "Unsupported image input mode: $IMAGE_INPUT_MODE"
            ;;
    esac
}


verify_container_image() {
    local container="$1"
    local expected_image="$2"
    local actual_image

    actual_image="$(docker inspect "$container" --format '{{.Config.Image}}')" \
        || fail "Container was not created: $container"
    [[ "$actual_image" == "$expected_image" ]] \
        || fail "Container $container is running $actual_image, expected $expected_image"
    log "Container $container is running expected image $expected_image"
}

verify_deployed_revision() {
    local current_head
    local expected_image
    local deployed_config_sha

    current_head="$(git rev-parse HEAD)"
    [[ "$current_head" == "$EXPECTED_SHA" ]] \
        || fail "Production worktree HEAD is $current_head, expected $EXPECTED_SHA"

    deployed_config_sha="$(grep -m1 '^ZDZQ_CONFIG_SHA=' "$ENV_FILE" | cut -d= -f2-)" \
        || fail 'Deployed environment is missing ZDZQ_CONFIG_SHA'
    [[ "$deployed_config_sha" == "$CONFIG_SHA" ]] \
        || fail "Deployed CONFIG_SHA is $deployed_config_sha, expected $CONFIG_SHA"

    expected_image="$IMAGE_NAME:$EXPECTED_SHA"
    verify_container_image "$API_CONTAINER" "$expected_image"
    verify_container_image "$WORKER_CONTAINER" "$expected_image"
}

restore_previous_image() {
    [[ -n "$previous_image_id" ]] || return 0

    log "Restoring previous application image $previous_image_id"
    docker tag "$previous_image_id" "$IMAGE_NAME:rollback"
    APP_IMAGE_TAG=rollback docker compose \
        -f "$COMPOSE_FILE" \
        --env-file "$ENV_FILE" \
        up -d --no-build --force-recreate api worker
}

cleanup() {
    local exit_code=$?

    if [[ "$exit_code" -ne 0 ]]; then
        zdzq_env_restore "$ENV_FILE" || log 'Automatic environment rollback failed'
        if [[ "$services_switched" -eq 1 ]]; then
            restore_previous_image || log 'Automatic application rollback failed'
        fi
    fi

    zdzq_env_cleanup

    if [[ -n "$backup_temporary_file" ]]; then
        rm -f -- "$backup_temporary_file"
    fi

    if [[ -n "$image_archive" ]]; then
        rm -f -- "$image_archive"
    fi

    if [[ -n "$docker_config_dir" && -d "$docker_config_dir" ]]; then
        rm -rf -- "$docker_config_dir"
    fi

    if [[ "$exit_code" -ne 0 ]]; then
        log "Deployment failed with exit code $exit_code" >&2
    fi

    trap - EXIT
    exit "$exit_code"
}

trap cleanup EXIT

[[ "$(id -u)" -eq 0 ]] || fail 'This script must run as root'
[[ "$EXPECTED_SHA" =~ ^[0-9a-f]{40}$ ]] \
    || fail 'Expected one lowercase 40-character Git commit SHA'
[[ "$CONFIG_SHA" =~ ^[0-9a-f]{64}$ ]] \
    || fail 'Expected one lowercase 64-character CONFIG_SHA'
[[ -n "$ENV_PROD_B64" ]] \
    || fail 'Managed production environment payload is required'

exec 9>"$LOCK_FILE"
flock -n 9 || fail 'Another deployment is already running'

[[ -d "$APP_DIR/.git" ]] || fail "Git repository not found at $APP_DIR"
[[ -f "$COMPOSE_FILE" ]] || fail "Compose file not found: $COMPOSE_FILE"
[[ -f "$ENV_FILE" ]] || fail "Environment file not found: $ENV_FILE"
command -v mysqldump >/dev/null || fail 'mysqldump is not installed'

cd "$APP_DIR"
git config core.fileMode false

log 'Fetching origin/master'
git fetch --quiet --prune origin master

readonly REMOTE_SHA="$(git rev-parse origin/master)"
readonly CURRENT_SHA="$(git rev-parse HEAD)"

[[ "$EXPECTED_SHA" == "$REMOTE_SHA" ]] \
    || fail "Requested commit $EXPECTED_SHA is not current origin/master $REMOTE_SHA"
[[ "$(git branch --show-current)" == 'master' ]] \
    || fail 'Production worktree must remain on master'

if ! git diff --quiet || ! git diff --cached --quiet \
    || [[ -n "$(git ls-files --others --exclude-standard)" ]]; then
    fail 'Production worktree is dirty; refusing to overwrite server changes'
fi

git merge-base --is-ancestor "$CURRENT_SHA" "$EXPECTED_SHA" \
    || fail "Deployment is not a fast-forward from $CURRENT_SHA to $EXPECTED_SHA"

prepare_image

log "Updating application from $CURRENT_SHA to $EXPECTED_SHA"
git merge --quiet --ff-only "$EXPECTED_SHA"

zdzq_env_install \
    "$ENV_FILE" \
    "$ENV_PROD_B64" \
    "$CONFIG_SHA" \
    "$ENV_BACKUP_DIR" \
    ENV_SECRET_KEYS \
    ENV_REQUIRED_KEYS \
    ENV_NONEMPTY_SECRET_KEYS
install -d -m 0755 -o 100 -g 101 "$AVATAR_DIR"
compose config --quiet
backup_database

if docker inspect "$API_CONTAINER" >/dev/null 2>&1; then
    previous_image_id="$(docker inspect "$API_CONTAINER" --format '{{.Image}}')"
    docker tag "$previous_image_id" "$IMAGE_NAME:rollback"
else
    log "No existing API container found; rollback image is not available for this deployment"
fi

compose rm -f -s migrate >/dev/null 2>&1 || true

log 'Applying database migrations'
compose --profile migrate run --rm --no-deps migrate

seed_admin_if_configured

log 'Recreating API and worker from the selected image'
services_switched=1
compose up -d --no-build --force-recreate api worker

log 'Checking local and public readiness endpoints'
for attempt in {1..20}; do
    if curl --fail --silent --show-error --max-time 5 "$LOCAL_HEALTH_URL" >/dev/null \
        && curl --fail --silent --show-error --max-time 5 "$HEALTH_URL" >/dev/null; then
        verify_deployed_revision
        services_switched=0
        log "Deployment completed successfully at $EXPECTED_SHA"
        ZDZQ_ENV_CHANGED=0
        zdzq_env_cleanup
        exit 0
    fi

    log "Readiness check attempt $attempt failed; retrying"
    sleep 3
done

fail "Readiness checks failed: $LOCAL_HEALTH_URL and $HEALTH_URL"
